{
    "name": "@minimalist-apps/android-e2e",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "e2e:emulator": "pnpm exec tsx ./src/startEmulatorCli.ts",
        "test": "node --import=tsx --import=../../test.setup.ts --test --test-concurrency=1 --test-force-exit \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
        "typecheck": "tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "dependencies": {
        "@minimalist-apps/cli": "workspace:*",
        "@minimalist-apps/utils": "workspace:*",
        "webdriverio": "^9.31.2"
    },
    "devDependencies": {
        "@minimalist-apps/tsconfig": "workspace:*",
        "@types/node": "^24.13.3"
    }
}
