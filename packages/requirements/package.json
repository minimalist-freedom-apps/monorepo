{
    "name": "@minimalist-apps/requirements",
    "version": "1.0.0",
    "type": "module",
    "bin": {
        "requirements-verify": "./src/scripts/verify.ts",
        "requirements-fix": "./src/scripts/fix.ts"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "dependencies": {
        "@minimalist-apps/android-build": "workspace:*",
        "@minimalist-apps/cli": "workspace:*",
        "@minimalist-apps/components": "workspace:*",
        "@minimalist-apps/type-utils": "workspace:*",
        "@napi-rs/canvas": "^1.0.7"
    },
    "devDependencies": {
        "@minimalist-apps/tsconfig": "workspace:*",
        "@types/node": "^24.13.3"
    },
    "scripts": {
        "test": "node --import=tsx --import=@minimalist-apps/test-runner/setup --test --test-concurrency=1 --test-force-exit \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
        "typecheck": "tsc --noEmit"
    }
}
