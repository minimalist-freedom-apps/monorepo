{
    "name": "@minimalist-apps/test-runner",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./setup": "./src/testSetup.ts"
    },
    "dependencies": {
        "@testing-library/react": "^16.3.2",
        "jsdom": "^30.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "scripts": {
        "test": "node --import=tsx --import=@minimalist-apps/test-runner/setup --test --test-concurrency=1 --test-force-exit \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@minimalist-apps/tsconfig": "workspace:*",
        "@types/jsdom": "^27.0.0",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "typescript": "^7.0.2"
    }
}
