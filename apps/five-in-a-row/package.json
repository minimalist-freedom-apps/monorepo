{
    "name": "@minimalist-apps/five-in-a-row",
    "version": "1.2.0",
    "description": "Two-player Five in a Row with adjustable board size",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:android": "APP_DIR=$PWD pnpm --filter @minimalist-apps/android-build dev",
        "build": "vite build",
        "build:android": "APP_DIR=$PWD pnpm --filter @minimalist-apps/android-build build",
        "build:android:debug": "APP_DIR=$PWD pnpm --filter @minimalist-apps/android-build build:debug",
        "build:android:sign": "APP_DIR=$PWD pnpm --filter @minimalist-apps/android-build sign",
        "preview": "vite preview",
        "test": "vitest run --config ../../vitest.config.ts --root .",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@capacitor/core": "^8.5.0",
        "@evolu/common": "^8.5.0",
        "@minimalist-apps/components": "workspace:*",
        "@minimalist-apps/connect": "workspace:*",
        "@minimalist-apps/fragment-local-storage": "workspace:*",
        "@minimalist-apps/fragment-navigator": "workspace:*",
        "@minimalist-apps/fragment-settings": "workspace:*",
        "@minimalist-apps/fragment-theme": "workspace:*",
        "@minimalist-apps/local-storage": "workspace:*",
        "@minimalist-apps/mini-store": "workspace:*",
        "@minimalist-apps/mobile-native": "workspace:*",
        "@minimalist-apps/navigator": "workspace:*",
        "@minimalist-apps/type-utils": "workspace:*",
        "@minimalist-apps/undo": "workspace:*",
        "@minimalist-apps/window": "workspace:*",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/cli": "^8.5.0",
        "@minimalist-apps/requirements": "workspace:*",
        "@minimalist-apps/tsconfig": "workspace:*",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2"
    }
}
