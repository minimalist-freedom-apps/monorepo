{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreBinaries": ["adb", "fc-match"],
    "ignoreDependencies": ["@aparajita/capacitor-secure-storage"],
    "ignoreFiles": ["**/android/**/build/**", "**/android/app/src/main/assets/public/**"],
    "tags": ["-lintignore", "-publicdep"],
    "workspaces": {
        ".": {},
        "apps/*": {
            "entry": ["src/**/*.test.{ts,tsx}", "e2e/{globalSetup.ts,*.e2e.ts}"]
        },
        "packages/*": {
            "entry": ["src/**/*.{test,spec}.{ts,tsx}"]
        }
    }
}
